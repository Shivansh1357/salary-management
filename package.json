{
  "name": "salary-management",
  "version": "1.0.0",
  "private": true,
  "description": "Salary management software for ACME org's HR team (Incubyte assessment)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @salary/api dev",
    "dev:web": "pnpm --filter @salary/web dev",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @salary/api test",
    "test:web": "pnpm --filter @salary/web test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @salary/api db:migrate",
    "db:seed": "pnpm --filter @salary/api db:seed",
    "setup": "pnpm install && pnpm --filter @salary/api db:setup"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
